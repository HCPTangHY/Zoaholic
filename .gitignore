# =====================
# Secrets / local config
# =====================
.env
.env.*

# main config file (do NOT commit real credentials)
api.yaml
api.yml
formatted.yaml

# local config variants
api.json
api.*.json

# local config backups (contain real credentials)
api.yaml.stale_*.bak
api.yaml.*.bak

# runtime data / volumes
data/
postgres_data/

# =====================
# Python
# =====================
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/

.venv/
venv/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
coverage/
htmlcov/

# =====================
# Node / Frontend
# =====================
**/node_modules/
**/dist/
**/.vite/
**/.cache/
*.tsbuildinfo

# Runtime/test logs are local output, not source files.
*.log

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend build output served by backend (generated by `frontend` build)
# If you deploy via Dockerfile (multi-stage build), static is generated during image build.
# Do NOT commit built files.
static/

# =====================
# Databases
# =====================
*.db
*.db-wal
*.db-shm

# =====================
# IDE / OS
# =====================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =====================
# Tools / Misc
# =====================
.wrangler/
.aider*

# git worktree directories (local)
.worktrees/

docker-compose-*.yml
plugins/secret_plugins/

# (If you use alembic locally and don't want it in repo)
# alembic/
# alembic.ini

.limcode/
# Only root test/ has a restricted allowlist; do not match frontend/test/.
/test/*
!/test/test_*.py
# frontend/test/ and tests/ source files are tracked normally.
# Do not add !frontend/test/**: it would re-include caches and logs.

# Packaging / isolated test environments
build/
.eggs/
.tox/
.nox/
pip-wheel-metadata/
.hypothesis/

# Local operational scripts and scratch output
.tmp/
.temp/
/tmp/
/temp/

# Test reports (keep source tests and dependency lockfiles versioned)
.coverage.*
/coverage.xml
/junit.xml
/junit-*.xml
test-results/
test-reports/
playwright-report/
blob-report/
.nyc_output/
yarn-error.log*

# New root-level ad-hoc tests and explicitly local suites are not project tests.
/test_*.py
/tests/local/
/tests/scratch/
/test/local/
/test/scratch/
