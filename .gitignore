# =====================
# Secrets / local config
# =====================
.env
.env.*

# main config file (do NOT commit real credentials)
api.yaml
api.yml
formatted.yaml

# local config variants
api.json
api.*.json

# runtime data / volumes
data/
postgres_data/

# =====================
# Python
# =====================
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/

.venv/
venv/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
coverage/
htmlcov/

# =====================
# Node / Frontend
# =====================
**/node_modules/
**/dist/
**/.vite/
**/.cache/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Frontend build output served by backend (generated by `frontend` build)
# If you deploy via Dockerfile (multi-stage build), static is generated during image build.
# Do NOT commit built files.
static/

# =====================
# Databases
# =====================
*.db
*.db-wal
*.db-shm

# =====================
# IDE / OS
# =====================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =====================
# Tools / Misc
# =====================
.wrangler/
.aider*

# git worktree directories (local)
.worktrees/

docker-compose-*.yml
plugins/secret_plugins/

# (If you use alembic locally and don't want it in repo)
# alembic/
# alembic.ini

.limcode/
test/*
# 修改原因：根级 test/ 已清理为纯回归测试目录，test_*.py 文件需要纳入版本控制，脚本和数据文件仍忽略。
# 修改方式：对 test/ 下的 test_*.py 追加例外；frontend/test 保持原有例外，并修正此前例外规则的拼写错误。
# 目的：新增回归测试无需 force-add，同时避免本地脚本、缓存和数据文件进入仓库。
!test/test_*.py
!frontend/test/
!frontend/test/**
